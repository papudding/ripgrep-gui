{
  "$schema": "../gen/schemas/macOS-schema.json",
  "identifier": "opener",
  "description": "Opener capabilities for Linux and macOS",
  "windows": ["main"],
  "permissions": [
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
       "allow": [
        {"path": "$APPDATA/**"},
        {"path": "$DOCUMENT/**"},
        {"path": "$HOME/**"}
      ]
    }
  ],
  "platforms": ["linux", "macOS"]
}