{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "filesystem",
  "description": "Filesystem capabilities for Linux and macOS",
  "windows": ["main"],
  "permissions": [
    "fs:default",
    {
      "identifier": "fs:allow-write-text-file",
       "allow": [
        {"path": "$APPDATA/**"},
        {"path": "$DOCUMENT/**"},
        {"path": "$HOME/**"}
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {"path": "$APPDATA/**"},
        {"path": "$DOCUMENT/**"},
        {"path": "$HOME/**"},
        {"path": "$CONFIG/**"}
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
       "allow": [
        {"path": "$APPDATA/**"},
        {"path": "$DOCUMENT/**"},
        {"path": "$HOME/**"}
      ]
    },
    {
      "identifier": "fs:allow-create",
       "allow": [
        {"path": "$APPDATA/**"},
        {"path": "$DOCUMENT/**"},
        {"path": "$HOME/**"}
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {"path": "$APPDATA/**"},
        {"path": "$DOCUMENT/**"},
        {"path": "$HOME/**"}
      ]
    }
  ],
  "platforms": ["linux", "macOS"]
}